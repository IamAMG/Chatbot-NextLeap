# Groww SIP Behavioral Discovery Pipeline - Backend secrets (NEVER committed)
# All keys are read only by the FastAPI server via backend/app/config.py.
# NEVER expose these to the frontend / browser.

# --- Supabase (PostgREST) - backend only ---
# Row Level Security is enabled on sip_pipeline_rows; the backend uses the
# service role / secret key so PostgREST can read/write.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=...

# --- LLM provider API keys (comma-separated for multi-key rotation / anti-429) ---
GROQ_API_KEYS=
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=
MISTRAL_API_KEYS=
XAI_API_KEYS=

# --- Reddit (optional; falls back to public .json endpoints if unset) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=groww-sip-discovery/1.0

# --- Optional web search ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
YOUTUBE_API_KEY=

# --- X / Twitter (API v2 bearer token) ---
X_BEARER_TOKEN=

# --- OpenAI / ChatGPT ---
OPENAI_API_KEY=

# --- App ---
APP_ENV=dev

# --- Scheduler (optional) ---
SCHEDULER_INTERVAL_HOURS=24
SCHEDULER_BASE_URL=http://127.0.0.1:8000
