# API keys for the HDFC FAQ Assistant (RAG prototype).
# Copy this file to `.env` and fill in your keys. `.env` is not committed.

# Mistral API key (required for answer generation, Phase 5.3)
MISTRAL_API_KEY=

# Optional: Hugging Face token (only if you hit HF download rate limits)
HF_TOKEN=

# Optional: default model override (defaults to "mistral-small-latest")
MISTRAL_MODEL=
